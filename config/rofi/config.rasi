configuration {
    modi: "drun,run,window,ssh,keys,filebrowser";
    icon-theme: "Papirus-Dark";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon}  {name}";
    location: 0;
    center: true;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: " 󰀻  Apps";
    display-run: " 󰌢  Run";
    display-window: " 󰕰  Windows";
    display-ssh: " 󰢹  SSH";
    display-keys: " 󰌌  Keys";
    display-filebrowser: " 󰉋  Files";
    sidebar-mode: true;
    click-to-exit: true;
    keyboard-navigation: true;
    scroll-method: 0;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    font: "JetBrainsMono Nerd Font 12";

    background:           rgba(11, 11, 20, 82%);
    foreground:           rgba(205, 214, 244, 100%);

    blue:                 rgba(137, 180, 250, 100%);
    red:                  rgba(243, 139, 168, 100%);
    green:                rgba(166, 227, 161, 100%);
    yellow:               rgba(249, 226, 175, 100%);
    mauve:                rgba(203, 166, 247, 100%);
    peach:                rgba(250, 179, 135, 100%);
    teal:                 rgba(148, 226, 213, 100%);
    lavender:             rgba(180, 190, 254, 100%);

    surface-0:            rgba(24, 24, 37, 100%);
    surface-1:            rgba(17, 17, 27, 100%);
    surface-2:            rgba(36, 36, 52, 100%);

    border-glow:          rgba(137, 180, 250, 35%);
    border-glow-hover:    rgba(137, 180, 250, 55%);
    border-glow-active:   rgba(137, 180, 250, 75%);

    text-muted:           rgba(108, 112, 134, 100%);

    normal-background:    transparent;
    normal-foreground:    @foreground;

    selected-normal-background: rgba(137, 180, 250, 18%);
    selected-normal-foreground: @blue;

    active-background:    rgba(137, 180, 250, 12%);
    active-foreground:    @blue;

    urgent-background:    rgba(243, 139, 168, 16%);
    urgent-foreground:    @red;

    alternate-normal-background: rgba(137, 180, 250, 6%);
    alternate-normal-foreground: @foreground;
    alternate-active-background: rgba(137, 180, 250, 12%);
    alternate-active-foreground: @blue;
    alternate-urgent-background: rgba(243, 139, 168, 16%);
    alternate-urgent-foreground: @red;

    selected-active-background: @selected-normal-background;
    selected-active-foreground: @blue;
    selected-urgent-background: rgba(243, 139, 168, 28%);
    selected-urgent-foreground: @red;

    border-color:         @border-glow;
    separatorcolor:       @surface-2;

    spacing:              0;

    lightbg:              rgba(238, 232, 213, 100%);
    lightfg:              rgba(88, 104, 117, 100%);

    background-color:     transparent;
}

window {
    background-color: @background;
    border:             2;
    border-color:       @border-glow;
    border-radius:      22px;
    padding:            0;
    width:              44%;
    location:           center;
    anchor:             center;
    box-shadow:         0 12px 48px rgba(0, 0, 0, 0.45);
}

mainbox {
    border:             0;
    padding:            0;
    margin:             0;
    spacing:            0;
    background-color:   transparent;
}

inputbar {
    children:           [ prompt, entry ];
    spacing:            0;
    padding:            12px 14px 12px 12px;
    margin:             12px 12px 8px 12px;
    background-color:   @surface-1;
    border-radius:      16px;
    border:             1;
    border-color:       @border-glow;
}

prompt {
    spacing:            0;
    text-color:         @surface-1;
    padding:            7px 16px;
    margin:             0 10px 0 0;
    background-color:   @blue;
    border-radius:      12px;
}

entry {
    spacing:            0;
    text-color:         @foreground;
    padding:            7px 14px;
    background-color:   transparent;
    placeholder:        "Search...";
    placeholder-color:  @text-muted;
}

mode-switcher {
    spacing:            8px;
    padding:            8px 16px;
    margin:             0 12px 8px 12px;
    background-color:   @surface-1;
    border-radius:      14px;
    border:             1;
    border-color:       @border-glow;
}

button {
    spacing:            4px;
    text-color:         @text-muted;
    padding:            7px 16px;
    background-color:   transparent;
    border-radius:      10px;
    border:             0;
    margin:             0;
}

button selected {
    background-color:   rgba(137, 180, 250, 16%);
    text-color:         @blue;
}

button active {
    text-color:         @foreground;
}

listview {
    fixed-height:       true;
    lines:              7;
    columns:            2;
    spacing:            5px;
    scrollbar:          true;
    padding:            6px 8px 10px 8px;
    margin:             0 12px 12px 12px;
    background-color:   transparent;
}

element {
    border:             0;
    padding:            9px 12px;
    border-radius:      12px;
    background-color:   transparent;
    text-color:         @foreground;
}

element-text {
    background-color:   inherit;
    text-color:         inherit;
}

element.normal.normal {
    background-color:   @surface-1;
    text-color:         @foreground;
}

element.normal.urgent {
    background-color:   @urgent-background;
    text-color:         @urgent-foreground;
}

element.normal.active {
    background-color:   @active-background;
    text-color:         @active-foreground;
}

element.selected.normal {
    background-color:   transparent;
    text-color:         @blue;
}

element.selected.urgent {
    background-color:   transparent;
    text-color:         @red;
}

element.selected.active {
    background-color:   transparent;
    text-color:         @blue;
}

element.alternate.normal {
    background-color:   @surface-0;
    text-color:         @foreground;
}

element.alternate.urgent {
    background-color:   @urgent-background;
    text-color:         @urgent-foreground;
}

element.alternate.active {
    background-color:   @active-background;
    text-color:         @active-foreground;
}

scrollbar {
    width:              7px;
    border:             0;
    padding:            0;
    margin:             2px 2px 2px 0;
    border-radius:      4px;
    background-color:   @surface-0;
    handle-color:       rgba(88, 91, 112, 50%);
    handle-width:       5px;
}

message {
    padding:            8px 14px;
    margin:             0 12px 10px 12px;
    background-color:   @surface-1;
    border-radius:      12px;
    border:             1;
    border-color:       @border-glow;
}

textbox {
    text-color:         @foreground;
    padding:            5px 10px;
    background-color:   transparent;
}

case-indicator {
    spacing:            0;
    text-color:         @text-muted;
}

num-filtered-rows, num-rows, textbox-num-separator {
    background-color:   transparent;
    text-color:         @text-muted;
}

textbox-num-separator {
    str:                "/";
    padding:            0 3px;
}

textbox-prompt-colon {
    expand:             false;
    str:                "";
}
