@import "config.rasi"

window {
    width:              35%;
}

inputbar {
    children:           [ prompt ];
}

prompt {
    padding:            8px 16px;
    background-color:   @peach;
    text-color:         @surface-1;
}

listview {
    lines:              4;
    columns:            1;
    fixed-height:       true;
}

element {
    padding:            12px 16px;
}

element.selected {
    background-color:   rgba(250, 179, 135, 18%);
    text-color:         @peach;
}
