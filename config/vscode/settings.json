  "editor.tokenColorCustomizations": {
    "comments": "#6c7086 italic",
    "textMateRules": [
      {
        "scope": [
          "comment",
          "comment.block",
          "comment.line",
          "comment.block.documentation"
        ],
        "settings": {
          "foreground": "#6c7086",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "keyword.control",
          "keyword.operator.new",
          "keyword.operator.expression"
        ],
        "settings": {
          "foreground": "#cba6f7"
        }
      },
      {
        "scope": [
          "string",
          "string.quoted",
          "string.template"
        ],
        "settings": {
          "foreground": "#a6e3a1"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language"
        ],
        "settings": {
          "foreground": "#fab387"
        }
      },
      {
        "scope": [
          "variable",
          "variable.other",
          "variable.language"
        ],
        "settings": {
          "foreground": "#cdd6f4"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "meta.function-call"
        ],
        "settings": {
          "foreground": "#89b4fa"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "entity.other.inherited-class"
        ],
        "settings": {
          "foreground": "#f9e2af"
        }
      },
      {
        "scope": [
          "support.type",
          "support.class"
        ],
        "settings": {
          "foreground": "#f9e2af"
        }
      },
      {
        "scope": [
          "keyword.operator.assignment",
          "keyword.operator.arithmetic",
          "keyword.operator.comparison",
          "keyword.operator.logical"
        ],
        "settings": {
          "foreground": "#89dceb"
        }
      },
      {
        "scope": [
          "punctuation.definition.tag",
          "punctuation.definition.block",
          "punctuation.definition.parameters"
        ],
        "settings": {
          "foreground": "#94e2d5"
        }
      },
      {
        "scope": [
          "entity.other.attribute-name"
        ],
        "settings": {
          "foreground": "#f9e2af",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "support.function",
          "support.variable"
        ],
        "settings": {
          "foreground": "#f5c2e7"
        }
      },
      {
        "scope": [
          "entity.name.tag",
          "meta.tag"
        ],
        "settings": {
          "foreground": "#89b4fa"
        }
      },
      {
        "scope": [
          "markup.heading",
          "entity.name.section"
        ],
        "settings": {
          "foreground": "#89b4fa",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "markup.italic"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "markup.bold"
        ],
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "markup.deleted"
        ],
        "settings": {
          "foreground": "#f38ba8"
        }
      },
      {
        "scope": [
          "markup.inserted"
        ],
        "settings": {
          "foreground": "#a6e3a1"
        }
      },
      {
        "scope": [
          "markup.changed"
        ],
        "settings": {
          "foreground": "#fab387"
        }
      }
    ]
  },
  "accessibility.signals.terminalBell": {
    "sound": "off"
  },
  "terminal.integrated.enableVisualBell": false,
  "files.autoSave": "afterDelay"
}
