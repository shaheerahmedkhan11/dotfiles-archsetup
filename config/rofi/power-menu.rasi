@import "config.rasi"

window {
    width:              35%;
}

inputbar {
    children:           [ prompt ];
}

prompt {
    padding:            8px 16px;
    background-color:   @red;
    text-color:         @surface-1;
}

listview {
    lines:              6;
    columns:            1;
    fixed-height:       true;
}

element {
    padding:            12px 16px;
}

element.selected {
    background-color:   rgba(243, 139, 168, 18%);
    text-color:         @red;
}
