@import "config.rasi"

window {
    width:              40%;
}

inputbar {
    children:           [ prompt ];
}

prompt {
    padding:            8px 16px;
    background-color:   @green;
    text-color:         @surface-1;
}

listview {
    lines:              5;
    columns:            1;
    fixed-height:       true;
}

element {
    padding:            12px 16px;
}

element selected {
    background-color:   rgba(166, 227, 161, 18%);
    text-color:         @green;
}
